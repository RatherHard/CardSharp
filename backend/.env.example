# ---- 应用 ----
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/v1

# ---- 数据库 ----
DATABASE_URL=postgresql+asyncpg://cardsharp:cardsharp@localhost:5432/cardsharp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- 认证 ----
# 生产环境必须替换：openssl rand -hex 32
JWT_SECRET=dev-only-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- LLM ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_STRONG=deepseek-chat
LLM_MODEL_FAST=deepseek-chat
LLM_TIMEOUT_SECONDS=120

# ---- 嵌入 ----
EMBEDDING_BASE_URL=http://localhost:8080
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---- 对象存储 ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devdevdev
S3_BUCKET=cardsharp
S3_REGION=us-east-1

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000"]
